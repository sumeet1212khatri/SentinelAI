# ==============================================================================
# SentinelAI-RAG Enterprise Gateway — Environment Configuration Example
# Copy this file to .env and fill in your keys, or leave blank to use the
# 100% offline Deterministic RAG Simulator or the in-browser 3D Bunny BYOK Vault.
# ==============================================================================

# --- LLM API Credentials (Optional: Leave blank for offline / BYOK mode) ---
GROQ_API_KEY=
OPENAI_API_KEY=

# --- Service Host & Port (Render dynamically sets PORT) ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
PORT=8000

# --- Default Models ---
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_MODEL=gpt-4o-mini

# --- Gateway & RAG Engine Parameters ---
USE_LOCAL_SIMULATOR=true
CACHE_SIMILARITY_THRESHOLD=0.92
RAG_TOP_K=4
RATE_LIMIT_RPM=120
RATE_LIMIT_BURST=20
MAX_TOKENS=1200

# --- Guardrails Policy Toggles ---
PII_REDACTION_ENABLED=true
PROMPT_INJECTION_ENABLED=true
OUTPUT_GUARD_ENABLED=true
